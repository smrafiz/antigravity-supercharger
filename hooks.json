{
  "supercharger": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/supercharger pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/supercharger post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./bin/supercharger stop",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "./bin/supercharger session-start",
        "timeout": 5
      }
    ]
  }
}
